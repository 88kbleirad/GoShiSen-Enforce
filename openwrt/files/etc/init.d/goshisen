#!/bin/sh /etc/rc.common
# GoShiSen-Enforce procd init script.
#
# The service is DISABLED by default (UCI goshisen.main.enabled=0).
# Enable with `uci set goshisen.main.enabled='1'; uci commit goshisen;
# /etc/init.d/goshisen enable` then start.
#
# The hook is installed only after the config validates; a failed
# start leaves the firewall untouched (fail-closed by absence). When
# the main service is enabled, the boot guard (goshisen-boot, START=12)
# has already installed the fail-closed forward chain, so a start
# failure means "forwarding stays blocked", never "forwarding opens".
#
# Ports: api_port / metrics_port are ALWAYS rendered explicitly. An
# absent or empty UCI option is treated as 0 (= listener disabled) with
# a logread warning; a non-numeric or out-of-range value aborts the
# start with a message naming the option. Nothing is ever silently
# started on a listener the config asked to disable.

USE_PROCD=1

START=90
STOP=10

GOSHISEN_BIN=/usr/sbin/goshisen
UCI_CONFIG_DIR=""
# UCI_CONFIG_PATH is the file holding the token; overridable so the
# contract tests can assert the chmod without touching /etc/config.
UCI_CONFIG_PATH="${UCI_CONFIG_PATH:-/etc/config/goshisen}"
CONFIG_PATH=/var/run/goshisen/config.yaml
POLICY_PATH=""
API_PORT=""
METRICS_PORT=""

# warn/error log to both syslog (logread) and the init stderr, so an
# operator sees the same message interactively and after a boot.
uci_warn() {
	logger -t goshisen -p daemon.warn "$1"
	echo "goshisen: $1" >&2
}
uci_err() {
	logger -t goshisen -p daemon.err "$1"
	echo "goshisen: $1" >&2
}

# normalize_port <option-name> <value>
#
# Prints the port to use on success. An absent/empty option yields 0
# (listener disabled) plus a warning; a malformed value returns 1 after
# logging which option is wrong. This is the ONLY place a port value is
# interpreted, so validate_uci and render_config can never disagree.
normalize_port() {
	local opt="$1" val="$2" bare

	if [ -z "$val" ]; then
		uci_warn "$opt is not set; treating it as 0 (listener disabled)"
		echo 0
		return 0
	fi

	case "$val" in
		*[!0-9]*)
			uci_err "$opt '$val' is not a port (0-65535); refusing to start"
			return 1
			;;
	esac

	# Strip leading zeros so the arithmetic below is decimal, not octal.
	bare=$(printf '%s' "$val" | sed 's/^0*//')
	[ -n "$bare" ] || bare=0
	if [ "$bare" -gt 65535 ]; then
		uci_err "$opt '$val' is out of range 0-65535; refusing to start"
		return 1
	fi
	echo "$bare"
}

# service_enabled returns 0 when UCI says the service is enabled
# (goshisen.main.enabled=1). start/reload must refuse otherwise: the
# packaged default is disabled.
service_enabled() {
	local enabled

	# UCI config is not auto-loaded by rc.common; load it explicitly.
	config_load goshisen

	config_get enabled main enabled
	[ "$enabled" = 1 ]
}

validate_uci() {
	local queue_num scope log_level policy

	config_get queue_num main queue_num
	[ -n "$queue_num" ] || {
		uci_err "queue_num is required"
		return 1
	}
	[ "$queue_num" -ge 0 ] 2>/dev/null && [ "$queue_num" -le 65534 ] 2>/dev/null || {
		uci_err "queue_num $queue_num out of range 0-65534"
		return 1
	}

	config_get scope main hook_scope
	case "$scope" in
		""|openwrt|forward-all) ;;
		*) uci_err "unsupported hook_scope '$scope'"; return 1 ;;
	esac

	config_get log_level main log_level
	case "$log_level" in
		debug|info|warn|error) ;;
		*) uci_err "unsupported log_level '$log_level'"; return 1 ;;
	esac

	config_get offload main offload_policy
	case "$offload" in
		""|warn|refuse|readiness|enforce) ;;
		*) uci_err "unsupported offload_policy '$offload'"; return 1 ;;
	esac

	config_get policy main policy_file
	POLICY_PATH="$policy"
	[ -n "$policy" ] && [ -f "$policy" ] || {
		uci_err "policy_file '$policy' does not exist"
		return 1
	}

	# Normalize both listener ports once, up front: a bad value must
	# block the start instead of reaching the daemon's YAML.
	API_PORT=$(normalize_port "api_port" "$(config_get main api_port)") || return 1
	METRICS_PORT=$(normalize_port "metrics_port" "$(config_get main metrics_port)") || return 1

	# api_token is rendered into the daemon YAML verbatim. Allow only a
	# conservative, YAML-plain-safe charset (letters, digits, _ - .) so
	# the rendered scalar can never be mis-parsed or need quoting the
	# operator cannot see; anything else aborts the start by name
	# (fail-closed).
	local token
	token=$(config_get main api_token)
	case "$token" in
		""|*[!A-Za-z0-9._-]*)
			if [ -n "$token" ]; then
				uci_err "api_token '$token' contains characters outside [A-Za-z0-9._-]; refusing to start"
				return 1
			fi
			;;
	esac

	# The UCI config itself holds the token in plaintext. OpenWrt's
	# uci commit preserves the file mode, so restrict it to root to keep
	# the token away from other local users. This is best-effort: a
	# future uci rewrite that resets the mode would re-open it, so the
	# rendered /var/run config (0600) remains the source of truth.
	if [ -n "$token" ]; then
		chmod 600 "$UCI_CONFIG_PATH" 2>/dev/null || true
	fi

	return 0
}

render_config() {
	# Render the YAML the daemon reads from UCI values. Values are
	# validated above; no shell metacharacters reach the daemon.
	# api_port/metrics_port come from validate_uci (normalized, never
	# empty), so the daemon always receives explicit integers: an
	# explicit 0 disables the listener, an explicit port enables it on
	# loopback.
	mkdir -p /var/run/goshisen
	# Create the rendered config with mode 600 from the first instant: a
	# redirect inherits the current umask (OpenWrt default 022 → 644),
	# so the token would be world-readable in the window before the
	# chmod below. The chmod stays as a second line of defense. The
	# previous umask is restored afterwards so the rest of the service
	# start is unaffected.
	_old_umask=$(umask)
	umask 077
	{
		echo "policy_file: $POLICY_PATH"
		echo "queue_num: $(config_get main queue_num)"
		echo "queue_maxlen: $(config_get main queue_maxlen)"
		echo "hook_scope: $(config_get main hook_scope)"
		echo "log_level: $(config_get main log_level)"
		echo "offload_policy: $(config_get main offload_policy)"
		# allow_bypass / allow_non_loopback_api_host are YAML booleans;
		# UCI stores 0/1.
		case "$(config_get main allow_bypass)" in
			1|on|true) echo "allow_bypass: true" ;;
			*) echo "allow_bypass: false" ;;
		esac
		case "$(config_get main allow_non_loopback_api_host)" in
			1|on|true) echo "allow_non_loopback_api_host: true" ;;
			*) echo "allow_non_loopback_api_host: false" ;;
		esac
		echo "interface: $(config_get main interface)"
		echo "api_host: $(config_get main api_host)"
		echo "api_port: $API_PORT"
		echo "metrics_port: $METRICS_PORT"
		# D1 hardening opt-ins (UCI 0/1 -> YAML booleans). Default false:
		# with a token configured the policy reads stay open unless the
		# operator opts in (see docs/openwrt.md).
		case "$(config_get main require_token_for_reads)" in
			1|on|true) echo "require_token_for_reads: true" ;;
			*) echo "require_token_for_reads: false" ;;
		esac
		case "$(config_get main metrics_token_required)" in
			1|on|true) echo "metrics_token_required: true" ;;
			*) echo "metrics_token_required: false" ;;
		esac
		# api_token is optional; when set it grants authenticated API
		# mutations. The rendered config is chmod 600 below so the
		# token is never world-readable on the device.
		TOKEN=$(config_get main api_token)
		if [ -n "$TOKEN" ]; then
			echo "api_token: $TOKEN"
		fi
	} > "$CONFIG_PATH"
	chmod 600 "$CONFIG_PATH"
	umask "$_old_umask"
	# A listener without a token is read-only: mutations answer 401. Say
	# so at start instead of letting an operator discover it from a 401.
	if [ "$API_PORT" != "0" ] && [ -z "$TOKEN" ]; then
		uci_warn "api_port is $API_PORT but api_token is not set; API mutations will be refused (401), reads stay open"
	fi
}

start_service() {
	service_enabled || {
		echo "goshisen: service is disabled (goshisen.main.enabled=0)" >&2
		return 1
	}
	validate_uci || return 1
	render_config

	procd_open_instance
	procd_set_param command "$GOSHISEN_BIN"
	procd_append_param command --config "$CONFIG_PATH"
	procd_set_param respawn 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# procd sends SIGTERM and waits; nothing else to do. The kernel
	# keeps the hook in place (fail-closed) until the daemon is
	# restarted or `goshisen hook cleanup` is run explicitly.
	service_enabled || return 0
	return 0
}

service_triggers() {
	procd_add_reload_trigger goshisen
}

reload_service() {
	# Policy reload: validate, then send SIGHUP so the current
	# enforcement is never dropped — a failed reload keeps the
	# previous policy. Full UCI config changes (queue_num, scope, ...)
	# require a restart.
	service_enabled || {
		echo "goshisen: service is disabled (goshisen.main.enabled=0)" >&2
		return 1
	}
	validate_uci || return 1
	# The service is registered with procd under the init script's
	# basename (goshisen), not the binary path.
	procd_send_signal goshisen "*" SIGHUP
}
