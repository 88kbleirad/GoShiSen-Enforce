#!/bin/sh /etc/rc.common
# GoShiSen-Enforce procd init script.
#
# The service is DISABLED by default (UCI goshisen.main.enabled=0).
# Enable with `uci set goshisen.main.enabled='1'; uci commit goshisen;
# /etc/init.d/goshisen enable` then start.
#
# The hook is installed only after the config validates; a failed
# start leaves the firewall untouched (fail-closed by absence).

USE_PROCD=1

START=90
STOP=10

GOSHISEN_BIN=/usr/sbin/goshisen
UCI_CONFIG_DIR=""
CONFIG_PATH=/var/run/goshisen/config.yaml
POLICY_PATH=""

# service_enabled returns 0 when UCI says the service is enabled
# (goshisen.main.enabled=1). start/reload must refuse otherwise: the
# packaged default is disabled.
service_enabled() {
	local enabled

	# UCI config is not auto-loaded by rc.common; load it explicitly.
	config_load goshisen

	config_get enabled main enabled
	[ "$enabled" = 1 ]
}

validate_uci() {
	local queue_num scope log_level iface policy api metrics qlen

	config_get queue_num main queue_num
	[ -n "$queue_num" ] || {
		echo "goshisen: queue_num is required" >&2
		return 1
	}
	[ "$queue_num" -ge 0 ] 2>/dev/null && [ "$queue_num" -le 65535 ] 2>/dev/null || {
		echo "goshisen: queue_num $queue_num out of range 0-65535" >&2
		return 1
	}

	config_get scope main hook_scope
	case "$scope" in
		""|openwrt|forward-all) ;;
		*) echo "goshisen: unsupported hook_scope '$scope'" >&2; return 1 ;;
	esac

	config_get log_level main log_level
	case "$log_level" in
		debug|info|warn|error) ;;
		*) echo "goshisen: unsupported log_level '$log_level'" >&2; return 1 ;;
	esac

	config_get offload main offload_policy
	case "$offload" in
		""|warn|refuse|readiness|enforce) ;;
		*) echo "goshisen: unsupported offload_policy '$offload'" >&2; return 1 ;;
	esac

	config_get policy main policy_file
	POLICY_PATH="$policy"
	[ -n "$policy" ] && [ -f "$policy" ] || {
		echo "goshisen: policy_file '$policy' does not exist" >&2
		return 1
	}

	config_get api main api_port
	[ -z "$api" ] || [ "$api" -ge 0 ] 2>/dev/null && [ "$api" -le 65535 ] 2>/dev/null || {
		echo "goshisen: api_port '$api' out of range" >&2
		return 1
	}

	config_get metrics main metrics_port
	[ -z "$metrics" ] || [ "$metrics" -ge 0 ] 2>/dev/null && [ "$metrics" -le 65535 ] 2>/dev/null || {
		echo "goshisen: metrics_port '$metrics' out of range" >&2
		return 1
	}

	return 0
}

render_config() {
	# Render the YAML the daemon reads from UCI values. Values are
	# validated above; no shell metacharacters reach the daemon.
	mkdir -p /var/run/goshisen
	{
		echo "policy_file: $POLICY_PATH"
		echo "queue_num: $(config_get main queue_num)"
		echo "queue_maxlen: $(config_get main queue_maxlen)"
		echo "hook_scope: $(config_get main hook_scope)"
		echo "log_level: $(config_get main log_level)"
		echo "offload_policy: $(config_get main offload_policy)"
		echo "allow_bypass: $(config_get main allow_bypass)"
		echo "interface: $(config_get main interface)"
		echo "api_port: $(config_get main api_port)"
		echo "metrics_port: $(config_get main metrics_port)"
	} > "$CONFIG_PATH"
}

start_service() {
	service_enabled || {
		echo "goshisen: service is disabled (goshisen.main.enabled=0)" >&2
		return 1
	}
	validate_uci || return 1
	render_config

	procd_open_instance
	procd_set_param command "$GOSHISEN_BIN"
	procd_append_param command --config "$CONFIG_PATH"
	procd_set_param respawn 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

stop_service() {
	# procd sends SIGTERM and waits; nothing else to do. The kernel
	# keeps the hook in place (fail-closed) until the daemon is
	# restarted or `goshisen hook cleanup` is run explicitly.
	service_enabled || return 0
	return 0
}

service_triggers() {
	procd_add_reload_trigger goshisen
}

reload_service() {
	# Policy reload: validate, then send SIGHUP so the current
	# enforcement is never dropped — a failed reload keeps the
	# previous policy. Full UCI config changes (queue_num, scope, ...)
	# require a restart.
	service_enabled || {
		echo "goshisen: service is disabled (goshisen.main.enabled=0)" >&2
		return 1
	}
	validate_uci || return 1
	# The service is registered with procd under the init script's
	# basename (goshisen), not the binary path.
	procd_send_signal goshisen "*" SIGHUP
}
