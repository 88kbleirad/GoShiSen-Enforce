# GoShiSen-Enforce UCI configuration.
#
# The service is DISABLED by default. Enable it explicitly with:
#   uci set goshisen.main.enabled='1'
#   uci commit goshisen
#   /etc/init.d/goshisen enable
#   /etc/init.d/goshisen start
#
# Listener ports: api_port / metrics_port are ALWAYS rendered into the
# daemon config as explicit numbers. An absent or empty option is
# treated as 0 = listener disabled (the init script logs a warning);
# the packaged defaults below are 0, so "stick with the packaged file"
# means both listeners are off. When you enable the service, decide
# explicitly whether you want the loopback management listeners; if you
# do, set a real port (e.g. api_port '8080', metrics_port '9090').

config goshisen 'main'
	# Master switch. When 0 the daemon is not started by procd.
	option enabled '0'
	# NFQUEUE queue number this daemon binds. Must not collide with
	# any other NFQUEUE consumer on the device (range 0-65534).
	option queue_num '100'
	# Hook scope: openwrt queues only traffic firewall4 has accepted on
	# the forward path (priority 1, policy accept, no NAT chains).
	option hook_scope 'openwrt'
	# Log level: debug | info | warn | error
	option log_level 'info'
	# Network interface the daemon reports as its attached interface
	# (used for host validation only; the hook is on the forward path).
	# This must be a kernel netdev name (e.g. br-lan), not a firewall
	# zone name.
	option interface 'br-lan'
	# Policy file (YAML; see docs/user-guide.md for the schema).
	option policy_file '/etc/goshisen/policy.yaml'
	# Management API bind host. Loopback only: 127.0.0.1, 127.x, ::1
	# or localhost. The daemon REFUSES to start with a non-loopback
	# api_host unless you explicitly opt in with
	# allow_non_loopback_api_host '1' (risk: the API becomes reachable
	# on the network; mutations still need the bearer token, but the
	# GET endpoints are unauthenticated).
	option api_host '127.0.0.1'
	# Opt-in to allow a non-loopback api_host (see above). Keep unset.
	# option allow_non_loopback_api_host '0'
	# Optional API bearer token. When set, the API requires it for
	# every mutation (validate/apply/activate); unauthenticated reads
	# (GET /v1/policy, /v1/policy/versions, /healthz, /readyz,
	# /metrics) stay open. Allowed characters: A-Za-z0-9._- (the value
	# is rendered into YAML verbatim; anything else aborts the start
	# naming this option). The rendered daemon config is chmod 600, so
	# the token is never world-readable on the device. Keep unset for
	# read-only API access.
	# option api_token ''
	# D1 hardening opt-ins. When api_token is set, these require it for
	# the read endpoints too. Default 0: GET /v1/policy and
	# /v1/policy/versions stay open (historical behavior, useful for
	# local tooling), and /metrics stays open for Prometheus. /healthz
	# and /readyz always stay open. Setting either without api_token is
	# a configuration error (the daemon refuses to start).
	# option require_token_for_reads '0'
	# option metrics_token_required '0'
	# Optional management API port. An explicit 0 (this file's default)
	# disables the API listener; 1..65535 enables it on loopback.
	# NOTE (v0.2.5/v0.2.6 binaries): the daemon ignores a file/flag 0 —
	# the listeners default to 8080/9090 loopback once the service is
	# enabled; disable with GOSHISEN_API_PORT=0 or enabled=0. This file
	# keeps '0' so the fixed daemon (post-v0.2.6) disables as intended.
	option api_port '0'
	# Optional Prometheus metrics port. An explicit 0 (this file's
	# default) disables the metrics listener. Same v0.2.5/v0.2.6
	# caveat as api_port.
	option metrics_port '0'
	# Kernel NFQUEUE queue length.
	option queue_maxlen '1024'
	# Flow-offload policy when nftables flow offloading is detected
	# (established flows bypass the queue — enforcement gap):
	#   warn      (default) log WARN + gauge, keep enforcing
	#   refuse    fail startup before installing the hook
	#   readiness keep enforcing but never become ready while offloading
	#   enforce   actively disable the offload (verified); fail closed if
	#             disable fails or state is unknown
	option offload_policy 'warn'
	# Explicit diagnostic/development escape hatch for offload_policy=enforce
	# only: allow_bypass=1 downgrades enforce to warn (loud warning). Never
	# default; invalid with other policies.
	option allow_bypass '0'