CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_BOARD="x86"
CONFIG_TARGET_SUBTARGET="64"
CONFIG_TARGET_ARCH_PACKAGES="x86_64"
# CONFIG_TARGET_ALL_PROFILES is not set
CONFIG_TARGET_x86_64_DEVICE_generic=y
CONFIG_ALL=n
CONFIG_ALL_KMODS=n
CONFIG_ALL_NONSHARED=n
# Explicitly drop the device-profile firmware blobs (amdgpu-firmware is
# several hundred MB and was the ENOSPC cause with CONFIG_ALL=y):
CONFIG_PACKAGE_amdgpu-firmware=n
CONFIG_PACKAGE_intel-microcode=n
CONFIG_PACKAGE_amd64-microcode=n
CONFIG_PACKAGE_linux-firmware=n
CONFIG_PACKAGE_goshisen=m
